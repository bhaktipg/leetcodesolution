SELECT  DATE_FORMAT(trans_date, '%Y-%m') AS month, t.country as country ,count(*) as trans_count,sum(t.state= 'approved') as approved_count, sum(t.amount) as trans_total_amount,sum(t.amount * (t.state = 'approved')) AS approved_total_amount
from Transactions t
GROUP BY DATE_FORMAT(trans_date, '%Y-%m'), t.country;