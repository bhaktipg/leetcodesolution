class Solution:
    def checkPerfectNumber(self, num: int) -> bool:
        a=[]

        for i in range(1,int(num**0.5)+1):
            if num%i==0:
                a.append(i)
                if i!=num//i:
                    a.append(num//i)
        a.remove(num)
        if sum(a)==num:
            return True
        else:
            return False