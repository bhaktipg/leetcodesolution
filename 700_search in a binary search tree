
class Solution:
    def searchBST(self, root: TreeNode | None, val: int) -> TreeNode | None:
        q = deque([root])
        while q:
            node = q.popleft()
            if node.val == val:
                return node
                print(node)
            if node.left:
                q.append(node.left)
            if node.right:
                q.append(node.right)
        return None