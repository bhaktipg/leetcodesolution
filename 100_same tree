# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def isSameTree(self, p: TreeNode | None, q: TreeNode | None) -> bool:
        
        a= deque([p])
        b= deque([q])

        while a and b:
            n1=a.popleft()
            n2=b.popleft()

            if not n1 and  not n2:
                continue
            if not n1 or not n2:
                return False
            if n1.val!=n2.val:
                return False
            a.append(n1.left)
            a.append(n1.right)
            b.append(n2.left)
            b.append(n2.right)
        return True
            