# Write your MySQL query statement below
select round(sum(tiv_2016),2) as tiv_2016
from Insurance i
where tiv_2015 in (
    select tiv_2015
    from Insurance i 
    group by tiv_2015
    having count(*)>1
)
and (lat,lon) in (
    select lat, lon
    from Insurance i
    group by lat,lon
    having count(*)=1
)